# Copy to .env and override before running anywhere beyond a local sandbox.
# All three have dev-only fallback defaults baked into app.py for zero-config demo use.

# Signs JWT bearer tokens. Must be a long random secret in any shared deployment.
JWT_SECRET=dev-insecure-secret-change-in-production

# Shared password for every seeded demo account (alice, bob, attacker_1..10, sybil_1..50, ...).
DEMO_PASSWORD=changeme123

# Password for the security_admin account (audit log, admin ban endpoints, SOC feed).
ADMIN_PASSWORD=admin_changeme123
