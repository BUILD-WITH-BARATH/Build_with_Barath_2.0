# Copy to .env and override before running anywhere beyond a local sandbox.

# REQUIRED, no default - Postgres connection string. This app is multi-tenant
# and Postgres-backed (no more SQLite). For local dev, point it at a free
# hosted Postgres (e.g. neon.tech, supabase.com) or a local Postgres instance.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Everything below has a dev-only fallback default baked into app.py for
# zero-config demo use - override all of them before running in production.

# Signs JWT bearer tokens for the demo dashboard's login flow.
JWT_SECRET=dev-insecure-secret-change-in-production

# Shared password for every seeded demo account (alice, bob, attacker_1..10, sybil_1..50, ...).
DEMO_PASSWORD=changeme123

# Password for the security_admin account (audit log, admin ban endpoints, SOC feed).
ADMIN_PASSWORD=admin_changeme123

# Required to create a new tenant via POST /v1/tenants (the product-API signup route).
# Keep this secret - anyone with it can mint tenants and API keys.
TENANT_SIGNUP_KEY=dev-insecure-signup-key-change-in-production
