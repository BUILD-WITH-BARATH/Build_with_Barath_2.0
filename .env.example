# ===== APPLICATION CONFIGURATION =====
APP_ENV=dev
DEMO_MODE=true
JWT_SECRET=dev-insecure-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ===== CREDENTIALS =====
DEMO_PASSWORD=changeme123
ADMIN_PASSWORD=admin_changeme123
TENANT_SIGNUP_KEY=dev-insecure-signup-key-change-in-production

# ===== DATABASE (PostgreSQL) =====
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/cyberaccess
POSTGRES_DB=cyberaccess
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# ===== REDIS CACHING =====
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_AUTH_CONTEXT=600
REDIS_CACHE_TTL_RISK_SCORE=300
REDIS_CACHE_TTL_QUOTAS=60

# ===== RATE LIMITING & QUOTAS =====
DEFAULT_REQUESTS_PER_MINUTE=1000
DEFAULT_MAX_AUDIT_EVENTS=1000000
DEFAULT_AUDIT_RETENTION_DAYS=365
DEFAULT_RISK_THRESHOLD_BLOCK=90
DEFAULT_RISK_THRESHOLD_WARN=70
RATE_LIMIT_WINDOW_SECONDS=60
QUOTA_ALERT_THRESHOLD_PERCENT=80
QUOTA_ALERT_BATCH_SIZE=50

# ===== ALERTING SYSTEM =====
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@cyberaccess.io
SMTP_PASSWORD=your-app-password-here

# Alert Timeouts
ALERT_SLACK_TIMEOUT=5
ALERT_EMAIL_TIMEOUT=10

# ===== CORS & SECURITY =====
FRONTEND_ORIGIN=*
BCRYPT_ROUNDS=4

# ===== GRAFANA =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ===== SERVICE PORTS =====
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
BACKEND_PORT=8000
FRONTEND_PORT=5173
DJANGO_PORT=8001

# ===== FEATURE FLAGS =====
FEATURE_REDIS_CACHING=true
FEATURE_ALERTING=true
FEATURE_MULTI_TENANT_QUOTAS=true
